---
// Temporary page for picking a design direction. Replace with the chosen option.
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.svg?raw';
const options = [
  { href: '/a/', name: 'A · Clean', text: 'White, plenty of space, slab headings like the logo, 3-photo collage hero.' },
  { href: '/b/', name: 'B · Bold', text: 'Green band hero, big condensed uppercase type, safety-yellow accents, photo mosaic.' },
  { href: '/c/', name: 'C · Blueprint', text: 'Light grid paper, technical labels, job-site video in a phone frame.' },
];
---
<Base noindex title="Turnpike Electric: design options">
  <main class="wrap" style="padding:64px 16px;max-width:760px">
    <div style="width:260px;margin-bottom:32px" set:html={logo} />
    <h1 style="font-size:2rem">Design options</h1>
    <p>Same content, three looks. Open each on desktop and on your phone.</p>
    <ul style="list-style:none;padding:0;display:grid;gap:14px">
      {
        options.map((o) => (
          <li style="border:1px solid var(--line);border-radius:12px;padding:18px 20px">
            <a href={o.href} style="font-weight:700;font-size:1.2rem">{o.name}</a>
            <p style="margin:6px 0 0;color:var(--muted)">{o.text}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
