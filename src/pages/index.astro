---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Process from '../components/Process.astro';
import ProjectCards from '../components/ProjectCards.astro';
import Reviews from '../components/Reviews.astro';
import VideoFeature from '../components/VideoFeature.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Industries from '../components/Industries.astro';
---
<Base overlayHeader>
  <Hero />

  <section class="section">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="label">What we do</p>
          <h2>One licensed contractor for the whole job</h2>
          <p>Commercial, hospitality and residential electrical, from a single service upgrade to a full building.</p>
        </div>
        <a class="link-arrow" href="/services/">All services <Icon name="arrow" size={16} /></a>
      </div>
      <ServiceGrid />
      <div class="industries-head">
        <p class="label">Industries we serve</p>
      </div>
      <Industries />
    </div>
  </section>
  <style>
    .industries-head {
      margin: 56px 0 18px;
    }
  </style>

  <section class="section band">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Turnkey solutions</p>
        <h2>Plans to final inspection, handled</h2>
        <p>Permits, inspections and vendor coordination are on us, so the electrical never holds up your schedule.</p>
      </div>
      <Process />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <VideoFeature />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="label">Selected projects</p>
          <h2>Hotels, schools and public buildings</h2>
        </div>
        <a class="link-arrow" href="/projects/">All projects <Icon name="arrow" size={16} /></a>
      </div>
      <ProjectCards limit={3} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="label">Reviews</p>
          <h2>5.0 stars from every client on Angi</h2>
        </div>
      </div>
      <Reviews limit={3} />
    </div>
  </section>

  <CtaBand />
</Base>
