---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { company, coverage } from '../data/site';
import { photo } from '../data/photos';
const team = photo('interior-lighting-ladder');
---
<Base title="About" description="Turnpike Electric was founded in 2010 in Miami with one premise: quality over anything and everything. Florida certified electrical contractor EC13004836.">
  <PageHeader label="About us · Since 2010" image="hero-team-yard" position="70% 40%" title="Quality over anything and everything." narrow />

  <section class="section">
    <div class="wrap about">
      <div class="text">
        <p class="lead">Turnpike Electric is a Florida certified electrical contractor based in Hialeah. For more than fifteen years we have wired hotels, condos, offices, restaurants, public facilities and homes, in new construction and remodels.</p>
        <p>We work turnkey. That means we start with the plans, handle the permits and inspections, coordinate with your other vendors and stay until the final sign-off. Fire alarm, data, generators and medium to large UPS installations are part of our work too.</p>
        <p>Our crews are bilingual. Se habla español.</p>
        <ul class="facts">
          <li><Icon name="badge" /><div><strong>{company.license}</strong><span>{company.licenseLabel}</span></div></li>
          <li><Icon name="building" /><div><strong>500+</strong><span>Permitted projects since {company.founded}</span></div></li>
          <li><Icon name="pin" /><div><strong>Statewide</strong><span>{company.tagline}</span></div></li>
        </ul>
      </div>
      <Picture class="team" src={team.src} alt={team.alt} widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 45vw" formats={['avif', 'webp']} />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Service area</p>
        <h2>Statewide, with crews in South Florida</h2>
        <p>Our Florida certified license covers the whole state, so we can take your project wherever it is.</p>
      </div>
      <ul class="chips">{coverage.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Reviews</p>
        <h2>What clients say</h2>
      </div>
      <Reviews />
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .about :global(.team) {
    height: auto;
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    box-shadow: var(--shadow);
  }
  .text p {
    color: var(--ink-2);
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 12px;
  }
  .facts li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--green-2);
  }
  .facts div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .facts strong {
    color: var(--ink);
    font-size: 1.05rem;
  }
  .facts span {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chips li {
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
