---
import { Picture } from 'astro:assets';
import WebForm from './WebForm.astro';
import { photo } from '../data/photos';
const img = photo('crew-trio-yard');
---
<section class="section alt" id="careers">
  <div class="wrap careers">
    <div>
      <span class="eyebrow" data-num="06 /">Careers</span>
      <h2>Now hiring electricians</h2>
      <p>We are busy year-round and looking for people who take pride in clean, code-compliant work.</p>
      <ul class="perks">
        <li>Steady work on commercial, hospitality and residential projects</li>
        <li>Helpers, apprentices, journeymen and foremen welcome</li>
        <li>A crew that values quality over anything and everything</li>
        <li>Se habla español</li>
      </ul>
      <div class="photo">
        <Picture src={img.src} alt={img.alt} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 45vw" formats={['avif', 'webp']} loading="lazy" />
      </div>
    </div>
    <WebForm id="apply-form" subject="Job application from the website" submitLabel="Send application" successText="Application sent. We will get back to you within 5 business days.">
      <h3>Apply in two minutes</h3>
      <label>Full name<input name="name" autocomplete="name" required /></label>
      <label>Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
      <label class="full">Email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Position
        <select name="position" required>
          <option value="">Choose…</option>
          <option>Helper / Apprentice</option>
          <option>Journeyman</option>
          <option>Foreman / Master</option>
          <option>Low voltage / Fire alarm tech</option>
        </select>
      </label>
      <label>Years of experience<input name="experience_years" type="number" min="0" max="60" inputmode="numeric" required /></label>
      <label>Own hand tools?
        <select name="own_tools"><option>Yes</option><option>No</option></select>
      </label>
      <label>Driver's license?
        <select name="drivers_license"><option>Yes</option><option>No</option></select>
      </label>
      <label class="full">Tell us about your experience<textarea name="message"></textarea></label>
    </WebForm>
  </div>
</section>
