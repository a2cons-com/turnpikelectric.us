---
// Option B "Bold": green band with big condensed type, photo mosaic overlapping the band.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { company, intro } from '../data/site';
import { photo } from '../data/photos';
const tiles = ['mast-panel-ladder', 'crew-panel-logo-shirts', 'interior-lighting-ladder', 'commercial-switchgear', 'commercial-meter-center'].map(photo);
---
<section class="hero-b">
  <div class="band">
    <div class="wrap">
      <span class="kicker">{company.licenseLabel} · {company.license}</span>
      <h1>Power done right.<br /><span>From Tallahassee to the Keys.</span></h1>
      <div class="row">
        <p class="lead">{intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#contact">Get a free estimate <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href={`tel:${company.officeTel}`}><Icon name="phone" size={18} /> {company.officePhone}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="mosaic">
      {
        tiles.map((t, i) => (
          <Picture class={`t${i}`} src={t.src} alt={t.alt} widths={[300, 500, 800]} sizes="(max-width: 700px) 50vw, 25vw" formats={['avif', 'webp']} loading="eager" />
        ))
      }
    </div>
  </div>
</section>
<style>
  .band {
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.06) 25%, transparent 25%) 0 0 / 28px 28px,
      var(--green-dark);
    color: #fff;
    padding: clamp(48px, 8vw, 104px) 0 clamp(120px, 14vw, 180px);
  }
  .kicker {
    display: inline-block;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--on-accent);
    padding: 6px 10px;
    margin-bottom: 22px;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 7.2rem);
    margin-bottom: 28px;
  }
  h1 span {
    color: var(--accent);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-end;
    justify-content: space-between;
  }
  .lead {
    max-width: 36em;
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.85);
    margin: 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ctas .btn-ghost {
    color: #fff;
  }
  .mosaic {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    grid-template-rows: 200px 200px;
    gap: 10px;
    margin-top: clamp(-150px, -11vw, -90px);
  }
  .mosaic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .mosaic :global(picture) {
    min-height: 0;
  }
  .mosaic :global(.t0) {
    grid-row: 1 / 3;
  }
  .mosaic :global(.t1) {
    grid-column: 2 / 4;
  }
  .mosaic :global(.t4) {
    grid-row: 1 / 3;
    grid-column: 4;
  }
  @media (max-width: 700px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 180px 140px 140px;
    }
    .mosaic :global(.t0) {
      grid-row: 1 / 3;
    }
    .mosaic :global(.t1) {
      grid-column: 2;
    }
    .mosaic :global(.t4) {
      grid-row: 3;
      grid-column: 1 / 3;
    }
  }
</style>
