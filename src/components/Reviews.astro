---
import { reviews } from '../data/site';
interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? reviews.slice(0, limit) : reviews;
---
<div class="reviews">
  {
    list.map((r) => (
      <figure class="review">
        <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote>“{r.text}”</blockquote>
        <figcaption>
          <span class="avatar" aria-hidden="true">{r.name.charAt(0)}</span>
          <span><strong>{r.name}</strong><br /><small>Verified review · {r.source}</small></span>
        </figcaption>
      </figure>
    ))
  }
</div>
<style>
  .reviews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .review {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  blockquote {
    margin: 0;
    font-size: 1.06rem;
    line-height: 1.6;
    flex: 1;
    color: var(--ink-2);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    line-height: 1.3;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
  }
  small {
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .reviews {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .reviews {
      grid-template-columns: 1fr;
    }
  }
</style>
