---
import Icon from './Icon.astro';
import WebForm from './WebForm.astro';
import { company } from '../data/site';
const a = company.address;
---
<section class="section" id="contact">
  <div class="wrap contact">
    <div>
      <span class="eyebrow" data-num="07 /">Contact</span>
      <h2>Tell us about your project</h2>
      <p>Free estimates. Send us your plans or a short description and we'll get back to you within 2 business days. For anything urgent, just call.</p>
      <ul class="contact-list">
        <li><span class="icon"><Icon name="phone" /></span><div><small>Office</small><a href={`tel:${company.officeTel}`}>{company.officePhone}</a></div></li>
        <li><span class="icon"><Icon name="phone" /></span><div><small>Field</small><a href={`tel:${company.fieldTel}`}>{company.fieldPhone}</a></div></li>
        <li><span class="icon"><Icon name="mail" /></span><div><small>Email</small><a href={`mailto:${company.email}`}>{company.email}</a></div></li>
        <li><span class="icon"><Icon name="pin" /></span><div><small>Office</small><a href={company.mapsUrl} rel="noopener" target="_blank">{a.street}<br />{a.city}, {a.region} {a.zip}</a></div></li>
        <li><span class="icon"><Icon name="badge" /></span><div><small>{company.licenseLabel}</small><strong>{company.license}</strong></div></li>
      </ul>
    </div>
    <WebForm id="quote-form" subject="New project inquiry from the website" submitLabel="Request a quote" successText="Thanks! We received your request and will reply within 2 business days.">
      <h3>Request a free estimate</h3>
      <label>Name<input name="name" autocomplete="name" required /></label>
      <label>Company <span>(optional)</span><input name="company" autocomplete="organization" /></label>
      <label>Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Project type
        <select name="project_type" required>
          <option value="">Choose…</option>
          <option>Commercial / Retail</option>
          <option>Hospitality / Multifamily</option>
          <option>Light industrial</option>
          <option>Residential</option>
          <option>Generator / UPS</option>
          <option>Fire alarm / Data</option>
          <option>Service or panel upgrade</option>
          <option>Other</option>
        </select>
      </label>
      <label>Project city<input name="city" autocomplete="address-level2" /></label>
      <label class="full">How can we help?<textarea name="message" required></textarea></label>
    </WebForm>
  </div>
</section>
