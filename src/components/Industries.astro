---
import Icon from './Icon.astro';
import { industries } from '../data/site';
---
<ul class="industries">
  {industries.map((i) => <li><Icon name={i.icon} size={20} />{i.label}</li>)}
</ul>
<style>
  .industries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--ink);
  }
  li :global(svg) {
    color: var(--green-2);
    flex: none;
  }
  @media (max-width: 860px) {
    .industries {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
