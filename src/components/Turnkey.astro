---
import { Picture } from 'astro:assets';
import { process } from '../data/site';
import { photo } from '../data/photos';
const img = photo('service-disconnect');
---
<section class="section alt" id="process">
  <div class="wrap turnkey">
    <div class="media">
      <Picture src={img.src} alt={img.alt} widths={[480, 800, 1100]} sizes="(max-width: 860px) 100vw, 45vw" formats={['avif', 'webp']} />
    </div>
    <div>
      <div class="section-head">
        <span class="eyebrow" data-num="02 /">Turnkey solutions</span>
        <h2>Plans to final inspection, handled</h2>
        <p>You get one point of contact. We take care of permits, inspections and coordination with vendors, so the electrical never holds up your schedule.</p>
      </div>
      <ol class="process">
        {
          process.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
<style>
  /* inside the half-width column the steps stack 2x2 */
  .turnkey .process {
    grid-template-columns: 1fr 1fr;
    row-gap: 32px;
  }
  .turnkey .process li::after {
    display: none;
  }
  @media (max-width: 520px) {
    .turnkey .process {
      grid-template-columns: 1fr;
    }
  }
</style>
