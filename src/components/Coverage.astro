---
import { company, coverage } from '../data/site';
---
<section class="section" id="coverage">
  <div class="wrap coverage">
    <div>
      <span class="eyebrow" data-num="05 /">Service area</span>
      <h2>{company.tagline}</h2>
      <p>Based in Hialeah and working all over the state. We hold a Florida certified (statewide) electrical contractor license, so we can take your project wherever it is.</p>
      <ul>{coverage.map((c) => <li>{c}</li>)}</ul>
    </div>
    <div class="map">
      <svg viewBox="-20 30 300 300" role="img" aria-label="Florida outline from the Turnpike Electric logo">
        <path fill="currentColor" d="M172.22,305.82h19.82l2.68-126.4h-20.35l-1.7,86.88c-1.48.39-3.72.73-6.12,0-3.25-.99-3.9-3.07-6.5-4.59-4.68-2.73-7.31,1.26-13.38-.38-3.37-.49-8.05-2.67-13.04-10.7h0c-24.45-50.58-48.89-101.16-73.34-151.74h-25.61l-21.4-28.28L0,83.38l24.37,33.48h22.93l71.09,146.01c4.26,5.85,11.05,12.99,20.64,14.52,5.07.81,7.55-.49,12.23.38,5.6,1.04,13.2,4.96,20.96,18.41"/>
        <polyline fill="currentColor" points="133.63 67.36 130.35 67.36 130.35 83.38 133.63 83.38 159.68 108.34 171.92 95.86 161.95 83.38"/>
        <path fill="currentColor" d="M133.63 67.36h140v16.01h-140z"/>
        <g font-family="var(--font-body)" font-size="13" font-weight="600" fill="var(--ink)">
          <circle cx="78" cy="75" r="5" fill="var(--ink)" /><text x="70" y="58">Tallahassee</text>
          <circle cx="205" cy="230" r="5" fill="var(--ink)" /><text x="215" y="234">Hialeah</text>
          <circle cx="182" cy="314" r="5" fill="var(--ink)" /><text x="198" y="318">The Keys</text>
        </g>
      </svg>
    </div>
  </div>
</section>
