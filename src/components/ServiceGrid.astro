---
// Bento grid: the photo services as large cards, the rest as compact tiles.
// detailed=true (services page) also lists what each service includes.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/site';
import { photo } from '../data/photos';

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---
<div class:list={['bento', { detailed }]}>
  {
    services.map((s) =>
      s.photo ? (
        <article class="tile big" id={s.slug}>
          <Picture src={photo(s.photo).src} alt={photo(s.photo).alt} widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 50vw" formats={['avif', 'webp']} loading="lazy" />
          <div class="overlay">
            <div class="icon-tile glass"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {detailed && <ul>{s.items.map((i) => <li>{i}</li>)}</ul>}
          </div>
        </article>
      ) : (
        <article class="tile" id={s.slug}>
          <div class="icon-tile"><Icon name={s.icon} /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {detailed && <ul>{s.items.map((i) => <li>{i}</li>)}</ul>}
        </article>
      ),
    )
  }
</div>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .tile {
    grid-column: span 2;
  }
  .tile {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .tile:hover {
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .tile .icon-tile {
    margin-bottom: 22px;
  }
  .tile h3 {
    margin-bottom: 8px;
  }
  .tile p {
    color: var(--muted);
    font-size: 0.97rem;
    margin: 0;
  }
  .big {
    grid-column: span 3;
    min-height: 380px;
    padding: 0;
    overflow: hidden;
    border: 0;
    color: #fff;
    display: flex;
    align-items: flex-end;
  }
  .big :global(picture),
  .big :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .big:hover :global(img) {
    transform: scale(1.04);
  }
  .overlay {
    position: relative;
    width: 100%;
    padding: 120px 28px 28px;
    background: linear-gradient(0deg, rgb(10 20 30 / 0.92) 0%, rgb(10 20 30 / 0.65) 50%, transparent 100%);
  }
  .big p {
    color: rgb(255 255 255 / 0.85);
    max-width: 34em;
  }
  .glass {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    font: 500 0.78rem/1 var(--font-mono);
    padding: 8px 10px;
    border-radius: 6px;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .big li {
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.2);
    color: #fff;
  }
  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .tile,
    .big {
      grid-column: span 1;
    }
  }
  @media (max-width: 600px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .big {
      grid-column: auto;
      min-height: 340px;
    }
  }
</style>
