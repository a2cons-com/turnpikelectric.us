---
import Icon from './Icon.astro';
import { company } from '../data/site';
---
<section class="cta-band">
  <div class="wrap inner">
    <div>
      <p class="label">Free estimates</p>
      <h2>Have plans or a project coming up?</h2>
      <p>Send us the drawings or a short description. We reply within 2 business days.</p>
    </div>
    <div class="ctas">
      <a class="btn btn-primary" href="/contact/">Request an estimate <Icon name="arrow" size={18} /></a>
      <a class="btn btn-glass" href={`tel:${company.officeTel}`}><Icon name="phone" size={18} /> {company.officePhone}</a>
    </div>
  </div>
</section>
<style>
  .cta-band {
    padding: 0 0 clamp(72px, 10vw, 128px);
  }
  .inner {
    max-width: calc(var(--wrap) - 2 * var(--gutter));
    display: flex;
    flex-wrap: wrap;
    gap: 28px 48px;
    align-items: center;
    justify-content: space-between;
    padding: clamp(36px, 5vw, 64px);
    border-radius: 28px;
    color: #fff;
    background:
      radial-gradient(600px 300px at 100% 0%, rgb(140 198 63 / 0.22), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--navy);
  }
  @media (max-width: 700px) {
    .inner {
      margin: 0 var(--gutter);
      width: auto;
    }
  }
  .label {
    color: var(--signal);
  }
  h2 {
    margin-bottom: 10px;
  }
  p {
    color: rgb(255 255 255 / 0.75);
    margin: 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
