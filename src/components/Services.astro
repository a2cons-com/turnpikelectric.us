---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section class="section" id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow" data-num="01 /">What we do</span>
      <h2>Commercial, hospitality and residential electrical</h2>
      <p>New construction and remodeling, from a single panel upgrade to a full building. One licensed contractor for the whole job.</p>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <article class="service">
            <div class="icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
