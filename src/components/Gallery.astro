---
import ZoomPicture from './ZoomPicture.astro';
import { photo, galleryOrder } from '../data/photos';
const items = galleryOrder.map(photo);
---
<div class="gallery">
  {
    items.map((p) => (
      <figure>
        <ZoomPicture photo={p} group="gallery" widths={[400, 700, 1000]} sizes="(max-width: 600px) 100vw, 33vw" />
      </figure>
    ))
  }
</div>
<style>
  .gallery {
    columns: 3 280px;
    column-gap: 16px;
  }
  figure {
    margin: 0 0 16px;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.5s ease;
  }
  figure:hover :global(img) {
    transform: scale(1.03);
  }
</style>
