---
// Option C "Blueprint": technical grid paper, text left, vertical job-site video + photo stack right.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { company, intro } from '../data/site';
import { photo } from '../data/photos';
const back = photo('crew-panel-logo-shirts');
const side = photo('interior-lighting-ladder');
---
<section class="hero-c">
  <div class="wrap">
    <div class="copy">
      <span class="eyebrow" data-num="EC13004836 /">Electrical contractor · Est. {company.founded}</span>
      <h1>Wired right the first time.</h1>
      <p class="lead">{intro}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">Request a free estimate <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href={`tel:${company.officeTel}`}><Icon name="phone" size={18} /> {company.officePhone}</a>
      </div>
      <dl class="specs">
        <div><dt>Coverage</dt><dd>Statewide</dd></div>
        <div><dt>Projects</dt><dd>500+ permitted</dd></div>
        <div><dt>Rating</dt><dd>5.0 ★ Angi</dd></div>
      </dl>
    </div>
    <div class="stage">
      <Picture class="back" src={back.src} alt={back.alt} widths={[400, 700]} sizes="30vw" formats={['avif', 'webp']} loading="eager" />
      <Picture class="side" src={side.src} alt={side.alt} widths={[400, 600]} sizes="25vw" formats={['avif', 'webp']} loading="eager" />
      <figure class="phone">
        <video src="/media/mast-install.mp4" poster="/media/mast-install-poster.jpg" autoplay muted loop playsinline aria-label="Electrician installing a service mast on a job site"></video>
        <figcaption>On site · service mast install</figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .hero-c {
    padding: clamp(40px, 6vw, 88px) 0;
  }
  .hero-c .wrap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 34em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 32px;
  }
  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--card);
    width: fit-content;
  }
  .specs div {
    padding: 12px 20px;
    border-left: 1px dashed var(--line);
  }
  .specs div:first-child {
    border-left: 0;
  }
  .specs dt {
    font: 500 0.72rem/1.2 ui-monospace, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .specs dd {
    margin: 4px 0 0;
    font-weight: 600;
  }
  .stage {
    position: relative;
    aspect-ratio: 1 / 1.05;
  }
  .stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .stage :global(.back) {
    position: absolute;
    left: 0;
    top: 0;
    width: 58%;
    height: 72%;
    border: 6px solid #fff;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgb(18 32 46 / 0.15);
    transform: rotate(-3deg);
  }
  .stage :global(.side) {
    position: absolute;
    left: 6%;
    bottom: 0;
    width: 50%;
    height: 40%;
    border: 6px solid #fff;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgb(18 32 46 / 0.15);
    transform: rotate(2deg);
  }
  .phone {
    position: absolute;
    right: 0;
    top: 6%;
    width: 44%;
    margin: 0;
    padding: 8px;
    background: #12202e;
    border-radius: 26px;
    box-shadow: 0 20px 40px rgb(18 32 46 / 0.25);
  }
  .phone video {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 19px;
  }
  .phone figcaption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font: 500 0.7rem/1 ui-monospace, Menlo, monospace;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    padding: 6px 8px;
    border-radius: 6px;
  }
  @media (max-width: 900px) {
    .hero-c .wrap {
      grid-template-columns: 1fr;
    }
    .stage {
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
    }
  }
</style>
