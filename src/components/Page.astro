---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import HeroA from './HeroA.astro';
import HeroB from './HeroB.astro';
import HeroC from './HeroC.astro';
import TrustBar from './TrustBar.astro';
import Services from './Services.astro';
import Turnkey from './Turnkey.astro';
import Projects from './Projects.astro';
import Reviews from './Reviews.astro';
import Coverage from './Coverage.astro';
import Careers from './Careers.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Powerline from './Powerline.astro';

interface Props {
  variant: 'a' | 'b' | 'c';
  noindex?: boolean;
}
const { variant, noindex } = Astro.props;
const Hero = { a: HeroA, b: HeroB, c: HeroC }[variant];
---
<Base variant={variant} noindex={noindex}>
  <Header />
  <main>
    <Hero />
    {variant !== 'b' && <TrustBar />}
    <Services />
    {variant === 'b' && <TrustBar />}
    <Turnkey />
    <Projects />
    <Reviews />
    <Coverage />
    <Careers />
    <Contact />
  </main>
  <Powerline />
  <Footer />
</Base>
