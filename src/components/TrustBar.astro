---
import { stats } from '../data/site';
---
<section class="trust" aria-label="At a glance">
  <div class="wrap">
    {
      stats.map((s) => (
        <div class="stat">
          <div class="value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>
