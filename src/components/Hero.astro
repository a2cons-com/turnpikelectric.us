---
// Home hero: full-bleed background photos that slowly crossfade behind a
// fixed headline. Only the first photo is part of the initial page load.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { company, intro, stats } from '../data/site';
import { photo, heroPhotos } from '../data/photos';

const slides = await Promise.all(
  heroPhotos.map(async (h) => {
    const src = photo(h.name).src;
    const widths = [768, 1280, 1920, 2560].filter((w) => w <= src.width).concat(src.width < 2560 ? [src.width] : []);
    const [avif, webp, jpg] = await Promise.all(
      (['avif', 'webp', 'jpeg'] as const).map((format) => getImage({ src, widths, format })),
    );
    return { ...h, avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, jpg: jpg.srcSet.attribute, fallback: jpg.src };
  }),
);
---
<section class="hero static">
  {
    slides.map((s, i) =>
      i === 0 ? (
        <picture class="bg active">
          <source type="image/avif" srcset={s.avif} sizes="100vw" />
          <source type="image/webp" srcset={s.webp} sizes="100vw" />
          <img src={s.fallback} srcset={s.jpg} sizes="100vw" alt="" fetchpriority="high" style={`--pos:${s.position};--pos-m:${s.mobilePosition}`} />
        </picture>
      ) : (
        <picture class="bg" data-slide>
          <source type="image/avif" data-srcset={s.avif} sizes="100vw" />
          <source type="image/webp" data-srcset={s.webp} sizes="100vw" />
          <img data-src={s.fallback} data-srcset={s.jpg} sizes="100vw" alt="" decoding="async" style={`--pos:${s.position};--pos-m:${s.mobilePosition}`} />
        </picture>
      ),
    )
  }
  <div class="slide-nav" aria-label="Background photos" data-slide-nav hidden>
    <button type="button" class="nav-btn" aria-label="Previous photo" data-prev>‹</button>
    {slides.map((_, i) => <button type="button" class="sdot" aria-label={`Photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-dot={i} />)}
    <button type="button" class="nav-btn" aria-label="Next photo" data-next>›</button>
  </div>
  <div class="wrap">
    <div class="copy">
      <p class="kicker"><span class="dot"></span>{company.licenseLabel} · {company.license}</p>
      <h1>Electrical work done right, <em>from Tallahassee to the Keys.</em></h1>
      <p class="sub">{intro}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/contact/">Request a free estimate <Icon name="arrow" size={18} /></a>
        <a class="btn btn-glass" href={`tel:${company.officeTel}`}><Icon name="phone" size={18} /> {company.officePhone}</a>
      </div>
    </div>
  </div>
</section>
<div class="wrap stats-wrap">
  <dl class="stats">
    {
      stats.map((s) => (
        <div>
          <dd>{s.value}</dd>
          <dt>{s.label}</dt>
        </div>
      ))
    }
  </dl>
</div>

<script>
  // After the page has fully loaded, fetch the other hero photos and crossfade
  // every 8 s. Arrow keys, the ‹ › buttons and dots switch by hand (and restart
  // the timer). Reduced motion: no auto-advance. Pauses while the tab is hidden.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slides = [...hero.querySelectorAll<HTMLElement>('.bg')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const nav = hero.querySelector<HTMLElement>('[data-slide-nav]')!;
    let i = 0;
    let timer = 0;

    const ready = (n: number) => {
      const img = slides[n].querySelector('img')!;
      return img.complete && img.naturalWidth > 0;
    };
    const show = (n: number) => {
      n = (n + slides.length) % slides.length;
      if (n === i) return;
      const img = slides[n].querySelector('img')!;
      if (!ready(n)) {
        img.addEventListener('load', () => show(n), { once: true });
        return;
      }
      // New photo fades in on top; the old one stays opaque underneath until
      // the fade is done, so the page background never shows through.
      hero.classList.remove('static');
      slides.forEach((s) => s.classList.remove('prev'));
      slides[i].classList.replace('active', 'prev');
      slides[n].classList.add('active');
      const old = slides[i];
      const incoming = slides[n];
      const done = () => {
        if (incoming.classList.contains('active')) old.classList.remove('prev');
      };
      incoming.addEventListener('animationend', done, { once: true });
      setTimeout(done, 2600); // backup if animationend doesn't fire
      dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === n)));
      i = n;
    };
    const restart = () => {
      clearInterval(timer);
      if (!reduced)
        timer = window.setInterval(() => {
          if (!document.hidden) show(i + 1);
        }, 8000);
    };
    const start = () => {
      hero.querySelectorAll<HTMLElement>('[data-slide]').forEach((pic) => {
        pic.querySelectorAll<HTMLElement>('[data-srcset]').forEach((el) => el.setAttribute('srcset', el.dataset.srcset!));
        const img = pic.querySelector<HTMLImageElement>('img')!;
        img.src = img.dataset.src!;
      });
      nav.hidden = false;
      restart();
    };
    const go = (n: number) => {
      show(n);
      restart();
    };
    hero.querySelector('[data-prev]')!.addEventListener('click', () => go(i - 1));
    hero.querySelector('[data-next]')!.addEventListener('click', () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (nav.hidden || t.closest('input, textarea, select, [contenteditable], dialog[open]')) return;
      if (e.key === 'ArrowRight') go(i + 1);
      if (e.key === 'ArrowLeft') go(i - 1);
    });
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(88svh, 800px);
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 48px) 0 140px;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
  }
  .bg,
  .bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .bg img {
    object-fit: cover;
    object-position: var(--pos);
  }
  .bg {
    opacity: 0;
    z-index: -4;
  }
  .bg.prev {
    opacity: 1;
    z-index: -3;
  }
  .bg.active {
    opacity: 1;
    z-index: -2;
  }
  .bg.active:not(:only-child) {
    animation: hero-fade 2s ease both;
  }
  .hero.static .bg.active {
    animation: none;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Same rule for .prev, so the outgoing photo keeps zooming (no snap
       back to 100%) while the next one fades in over it. */
    .bg.active img,
    .bg.prev img {
      animation: hero-zoom 10s linear both;
    }
  }
  .slide-nav {
    position: absolute;
    right: var(--gutter);
    bottom: 96px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.55;
    transition: opacity 0.2s;
  }
  .slide-nav:hover,
  .slide-nav:focus-within {
    opacity: 1;
  }
  .slide-nav[hidden] {
    display: none;
  }
  .nav-btn {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .sdot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.4);
    cursor: pointer;
  }
  .sdot[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.95);
  }
  @media (max-width: 760px) {
    .slide-nav {
      bottom: 84px;
    }
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.1);
    }
  }
  @media (max-width: 760px) {
    .bg img {
      object-position: var(--pos-m);
    }
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(10 20 30 / 0.92) 0%, rgb(10 20 30 / 0.72) 42%, rgb(10 20 30 / 0.25) 75%, rgb(10 20 30 / 0.15) 100%),
      linear-gradient(0deg, rgb(10 20 30 / 0.55) 0%, transparent 35%);
  }
  .hero::after {
    /* blueprint grid fading in from the left */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
  }
  .copy {
    max-width: 600px;
  }
  h1 {
    font-size: clamp(2.3rem, 4.2vw, 3.5rem);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 0.78rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 14px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    margin-bottom: 26px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgb(140 198 63 / 0.25);
  }
  h1 {
    margin-bottom: 22px;
  }
  h1 em {
    font-style: normal;
    color: var(--signal);
  }
  .sub {
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    color: rgb(255 255 255 / 0.82);
    max-width: 36em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .stats-wrap {
    position: relative;
    z-index: 2;
    margin-top: -72px;
  }
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .stats div {
    padding: 26px 28px;
    border-left: 1px solid var(--line);
  }
  .stats div:first-child {
    border-left: 0;
  }
  .stats dd {
    margin: 0;
    font: 700 clamp(1.5rem, 2.4vw, 2rem) / 1.1 var(--font-head);
    letter-spacing: -0.03em;
  }
  .stats dt {
    font: 500 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }
  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
      min-height: 92svh;
      padding-bottom: 110px;
    }
    .hero::before {
      background: linear-gradient(0deg, rgb(10 20 30 / 0.95) 0%, rgb(10 20 30 / 0.78) 50%, rgb(10 20 30 / 0.35) 100%);
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats div:nth-child(3) {
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .stats div {
      padding: 20px;
    }
  }
</style>
