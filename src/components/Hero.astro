---
// Home hero: one full-bleed background photo with the headline on top.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { company, intro, stats } from '../data/site';
import { photo, heroPhoto } from '../data/photos';

const img = photo(heroPhoto.name);
const widths = [768, 1280, 1920, 2560].filter((w) => w <= img.src.width).concat(img.src.width < 2560 ? [img.src.width] : []);
const avif = await getImage({ src: img.src, widths, format: 'avif' });
const webp = await getImage({ src: img.src, widths, format: 'webp' });
const jpg = await getImage({ src: img.src, widths, format: 'jpeg' });
---
<section class="hero">
  <picture class="bg">
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={webp.srcSet.attribute} sizes="100vw" />
    <img src={jpg.src} srcset={jpg.srcSet.attribute} sizes="100vw" alt="" fetchpriority="high" style={`--pos:${heroPhoto.position};--pos-m:${heroPhoto.mobilePosition}`} />
  </picture>
  <div class="wrap">
    <div class="copy">
      <p class="kicker"><span class="dot"></span>{company.licenseLabel} · {company.license}</p>
      <h1>Electrical work done right, <em>from Tallahassee to the Keys.</em></h1>
      <p class="sub">{intro}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/contact/">Request a free estimate <Icon name="arrow" size={18} /></a>
        <a class="btn btn-glass" href={`tel:${company.officeTel}`}><Icon name="phone" size={18} /> {company.officePhone}</a>
      </div>
    </div>
  </div>
</section>
<div class="wrap stats-wrap">
  <dl class="stats">
    {
      stats.map((s) => (
        <div>
          <dd>{s.value}</dd>
          <dt>{s.label}</dt>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(88svh, 800px);
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 48px) 0 140px;
    color: #fff;
    overflow: hidden;
  }
  .bg,
  .bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .bg img {
    object-fit: cover;
    object-position: var(--pos);
  }
  @media (max-width: 760px) {
    .bg img {
      object-position: var(--pos-m);
    }
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(10 20 30 / 0.92) 0%, rgb(10 20 30 / 0.72) 42%, rgb(10 20 30 / 0.25) 75%, rgb(10 20 30 / 0.15) 100%),
      linear-gradient(0deg, rgb(10 20 30 / 0.55) 0%, transparent 35%);
  }
  .hero::after {
    /* blueprint grid fading in from the left */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
  }
  .copy {
    max-width: 600px;
  }
  h1 {
    font-size: clamp(2.3rem, 4.2vw, 3.5rem);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 0.78rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 14px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    margin-bottom: 26px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgb(140 198 63 / 0.25);
  }
  h1 {
    margin-bottom: 22px;
  }
  h1 em {
    font-style: normal;
    color: var(--signal);
  }
  .sub {
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    color: rgb(255 255 255 / 0.82);
    max-width: 36em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .stats-wrap {
    position: relative;
    z-index: 2;
    margin-top: -72px;
  }
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .stats div {
    padding: 26px 28px;
    border-left: 1px solid var(--line);
  }
  .stats div:first-child {
    border-left: 0;
  }
  .stats dd {
    margin: 0;
    font: 700 clamp(1.5rem, 2.4vw, 2rem) / 1.1 var(--font-head);
    letter-spacing: -0.03em;
  }
  .stats dt {
    font: 500 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }
  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
      min-height: 92svh;
      padding-bottom: 110px;
    }
    .hero::before {
      background: linear-gradient(0deg, rgb(10 20 30 / 0.95) 0%, rgb(10 20 30 / 0.78) 50%, rgb(10 20 30 / 0.35) 100%);
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats div:nth-child(3) {
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .stats div {
      padding: 20px;
    }
  }
</style>
